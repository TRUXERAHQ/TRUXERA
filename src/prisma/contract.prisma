// use prisma-8
enum OrganizationStatus {
  @@type("pg/text@1")

  ACTIVE = "ACTIVE"
  SUSPENDED = "SUSPENDED"
}

enum BillingPlan {
  @@type("pg/text@1")

  TRIAL = "TRIAL"
  STARTER = "STARTER"
  PROFESSIONAL = "PROFESSIONAL"
  ENTERPRISE = "ENTERPRISE"
}

enum SubscriptionStatus {
  @@type("pg/text@1")

  TRIAL = "TRIAL"
  ACTIVE = "ACTIVE"
  PAUSED = "PAUSED"
  CANCELED = "CANCELED"
}

enum MembershipRole {
  @@type("pg/text@1")

  OWNER = "OWNER"
  ADMIN = "ADMIN"
  DISPATCHER = "DISPATCHER"
  DRIVER = "DRIVER"
  VIEWER = "VIEWER"
}

enum TruckStatus {
  @@type("pg/text@1")

  AVAILABLE = "AVAILABLE"
  ON_ROUTE = "ON_ROUTE"
  MAINTENANCE = "MAINTENANCE"
  OUT_OF_SERVICE = "OUT_OF_SERVICE"
}

enum DriverStatus {
  @@type("pg/text@1")

  AVAILABLE = "AVAILABLE"
  ON_DUTY = "ON_DUTY"
  OFF_DUTY = "OFF_DUTY"
  ON_LEAVE = "ON_LEAVE"
  INACTIVE = "INACTIVE"
}

enum DeliveryStatus {
  @@type("pg/text@1")

  PLANNED = "PLANNED"
  ASSIGNED = "ASSIGNED"
  PICKED_UP = "PICKED_UP"
  IN_TRANSIT = "IN_TRANSIT"
  DELIVERED = "DELIVERED"
  FAILED = "FAILED"
  CANCELLED = "CANCELLED"
}

enum RiskLevel {
  @@type("pg/text@1")

  LOW = "LOW"
  MEDIUM = "MEDIUM"
  HIGH = "HIGH"
}

enum SupportCategory {
  @@type("pg/text@1")

  TECHNICAL_ISSUE = "TECHNICAL_ISSUE"
  DATA_ISSUE = "DATA_ISSUE"
  ACCOUNT_ACCESS = "ACCOUNT_ACCESS"
  FLEET_OPERATIONS = "FLEET_OPERATIONS"
  OTHER = "OTHER"
}

enum SupportPriority {
  @@type("pg/text@1")

  LOW = "LOW"
  NORMAL = "NORMAL"
  HIGH = "HIGH"
  URGENT = "URGENT"
}

enum SupportStatus {
  @@type("pg/text@1")

  OPEN = "OPEN"
  IN_PROGRESS = "IN_PROGRESS"
  WAITING_FOR_CUSTOMER = "WAITING_FOR_CUSTOMER"
  RESOLVED = "RESOLVED"
  CLOSED = "CLOSED"
}

enum SupportRelatedKind {
  @@type("pg/text@1")

  LOAD = "LOAD"
  DELIVERY = "DELIVERY"
  TRUCK = "TRUCK"
  DRIVER = "DRIVER"
}

enum SupportMessageAuthor {
  @@type("pg/text@1")

  CUSTOMER = "CUSTOMER"
  SUPPORT = "SUPPORT"
}

enum FeedbackType {
  @@type("pg/text@1")

  PRODUCT_SUGGESTION = "PRODUCT_SUGGESTION"
  FEATURE_REQUEST = "FEATURE_REQUEST"
  UX_UI_FEEDBACK = "UX_UI_FEEDBACK"
  GENERAL_FEEDBACK = "GENERAL_FEEDBACK"
}

enum IntegrationType {
  @@type("pg/text@1")

  TMS = "TMS"
  ELD = "ELD"
  GPS_TELEMATICS = "GPS_TELEMATICS"
  OTHER = "OTHER"
}

enum IntegrationStatus {
  @@type("pg/text@1")

  CONNECTING = "CONNECTING"
  CONNECTED = "CONNECTED"
  SYNCING = "SYNCING"
  DEGRADED = "DEGRADED"
  ERROR = "ERROR"
  DISCONNECTED = "DISCONNECTED"
}

enum IntegrationAuthKind {
  @@type("pg/text@1")

  API_KEY = "API_KEY"
  API_KEY_BEARER = "API_KEY_BEARER"
  OAUTH2 = "OAUTH2"
  BEARER_TOKEN = "BEARER_TOKEN"
  BASIC = "BASIC"
}

enum ExternalEntityKind {
  @@type("pg/text@1")

  LOAD = "LOAD"
  DELIVERY = "DELIVERY"
  TRUCK = "TRUCK"
  DRIVER = "DRIVER"
  ASSIGNMENT = "ASSIGNMENT"
  CUSTOMER = "CUSTOMER"
}

enum IntegrationSyncStatus {
  @@type("pg/text@1")

  RUNNING = "RUNNING"
  SUCCEEDED = "SUCCEEDED"
  FAILED = "FAILED"
  PARTIAL = "PARTIAL"
}

enum IntegrationSyncTrigger {
  @@type("pg/text@1")

  INITIAL = "INITIAL"
  INCREMENTAL = "INCREMENTAL"
  MANUAL = "MANUAL"
  SCHEDULED = "SCHEDULED"
  WEBHOOK = "WEBHOOK"
}

enum IntegrationEventKind {
  @@type("pg/text@1")

  CONNECTED = "CONNECTED"
  DISCONNECTED = "DISCONNECTED"
  CONFIG_UPDATED = "CONFIG_UPDATED"
  CREDENTIAL_STORED = "CREDENTIAL_STORED"
  CREDENTIAL_ROTATED = "CREDENTIAL_ROTATED"
  CREDENTIAL_REVOKED = "CREDENTIAL_REVOKED"
  SYNC_STARTED = "SYNC_STARTED"
  SYNC_COMPLETED = "SYNC_COMPLETED"
  SYNC_FAILED = "SYNC_FAILED"
  WEBHOOK_RECEIVED = "WEBHOOK_RECEIVED"
  WEBHOOK_PROCESSED = "WEBHOOK_PROCESSED"
  WEBHOOK_FAILED = "WEBHOOK_FAILED"
  EXTERNAL_RECORD_MAPPED = "EXTERNAL_RECORD_MAPPED"
  EXTERNAL_RECORD_MAPPING_FAILED = "EXTERNAL_RECORD_MAPPING_FAILED"
  ACCOUNT_STATUS_CHANGED = "ACCOUNT_STATUS_CHANGED"
}

enum IntegrationWebhookStatus {
  @@type("pg/text@1")

  RECEIVED = "RECEIVED"
  PROCESSED = "PROCESSED"
  FAILED = "FAILED"
  IGNORED = "IGNORED"
}

enum SignalSubjectKind {
  @@type("pg/text@1")

  TRUCK = "TRUCK"
  DRIVER = "DRIVER"
  DELIVERY = "DELIVERY"
  LOAD = "LOAD"
}

enum DeliveryEventType {
  @@type("pg/text@1")

  STATUS_CHANGED = "STATUS_CHANGED"
  ASSIGNMENT_CHANGED = "ASSIGNMENT_CHANGED"
  ETA_UPDATED = "ETA_UPDATED"
  DELIVERY_ATTEMPTED = "DELIVERY_ATTEMPTED"
  EXCEPTION_REPORTED = "EXCEPTION_REPORTED"
  LOCATION_UPDATED = "LOCATION_UPDATED"
}

model Organization {
  id        Uuid               @id @onCreate(uuid(7))
  name      String
  slug      String             @unique
  timezone  String             @default("UTC")
  status    OrganizationStatus @default(ACTIVE)
  createdAt temporal.CreatedAt
  updatedAt temporal.UpdatedAt
}

model BillingSubscription {
  id                     Uuid               @id @onCreate(uuid(7))
  organizationId         Uuid               @unique
  plan                   BillingPlan
  status                 SubscriptionStatus
  trialStartAt           DateTime?
  trialEndAt             DateTime?
  providerKey            String?
  providerCustomerId     String?
  providerSubscriptionId String?
  monthlyPriceCents      Int?
  annualPriceCents       Int?
  vehicleLimit           Int?
  integrationLimit       Int?
  createdAt              temporal.CreatedAt
  updatedAt              temporal.UpdatedAt

  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model BillingWebhookEvent {
  id              Uuid               @id @onCreate(uuid(7))
  providerKey     String
  providerEventId String
  type            String
  organizationId  Uuid?
  status          String             @default("RECEIVED")
  error           String?
  createdAt       temporal.CreatedAt
  updatedAt       temporal.UpdatedAt

  @@unique([providerKey, providerEventId])
}

model User {
  id        Uuid               @id @onCreate(uuid(7))
  email     String             @unique
  name      String
  createdAt temporal.CreatedAt
  updatedAt temporal.UpdatedAt
}

model Membership {
  id             Uuid               @id @onCreate(uuid(7))
  organizationId Uuid
  userId         Uuid
  role           MembershipRole
  createdAt      temporal.CreatedAt
  updatedAt      temporal.UpdatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Truck {
  id                Uuid               @id @onCreate(uuid(7))
  organizationId    Uuid
  unitNumber        String
  vin               String?
  status            TruckStatus        @default(AVAILABLE)
  capacityKg        Decimal?
  currentLocation   String?
  locationUpdatedAt DateTime?
  deactivatedAt     DateTime?
  createdAt         temporal.CreatedAt
  updatedAt         temporal.UpdatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, unitNumber])
  @@unique([organizationId, id])
  @@index([organizationId, status])
}

model Driver {
  id             Uuid               @id @onCreate(uuid(7))
  organizationId Uuid
  userId         Uuid?
  name           String
  phone          String?
  licenseNumber  String?
  status         DriverStatus       @default(AVAILABLE)
  createdAt      temporal.CreatedAt
  updatedAt      temporal.UpdatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user           User?              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, licenseNumber])
  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId, status])
}

model Load {
  id                Uuid               @id @onCreate(uuid(7))
  organizationId    Uuid
  reference         String
  customerName      String
  pickupAddress     String
  pickupWindowStart DateTime?
  pickupWindowEnd   DateTime?
  cargoDescription  String?
  weightKg          Decimal?
  createdAt         temporal.CreatedAt
  updatedAt         temporal.UpdatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, reference])
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
}

model Delivery {
  id                  Uuid               @id @onCreate(uuid(7))
  organizationId      Uuid
  loadId              Uuid
  stopNumber          Int
  reference           String?
  recipientName       String?
  destinationAddress  String
  deliveryWindowStart DateTime?
  deliveryWindowEnd   DateTime?
  eta                 DateTime?
  status              DeliveryStatus     @default(PLANNED)
  riskLevel           RiskLevel          @default(LOW)
  deliveredAt         DateTime?
  createdAt           temporal.CreatedAt
  updatedAt           temporal.UpdatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  load                Load               @relation(fields: [organizationId, loadId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, loadId, stopNumber])
  @@index([organizationId, status])
  @@index([organizationId, eta])
}

model DispatchAssignment {
  id               Uuid      @id @onCreate(uuid(7))
  organizationId   Uuid
  deliveryId       Uuid
  truckId          Uuid
  driverId         Uuid
  assignedByUserId Uuid?
  assignedAt       DateTime  @default(now()) @onCreate(now())
  endedAt          DateTime?
  endReason        String?

  delivery         Delivery  @relation(fields: [organizationId, deliveryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  truck            Truck     @relation(fields: [organizationId, truckId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  driver           Driver    @relation(fields: [organizationId, driverId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  assignedByUser   User?     @relation(fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, deliveryId, assignedAt], name: "dispatch_delivery_assigned_idx")
  @@index([organizationId, deliveryId], unique: true, where: sql`"endedAt" IS NULL`, name: "dispatch_active_delivery_unique")
  @@index([organizationId, truckId, endedAt])
  @@index([organizationId, driverId, endedAt])
  @@index([assignedByUserId])
}

model SupportRequest {
  id              Uuid               @id @onCreate(uuid(7))
  organizationId  Uuid
  requesterUserId Uuid
  reference       String
  subject         String
  category        SupportCategory
  priority        SupportPriority
  status          SupportStatus      @default(OPEN)
  description     String
  relatedKind     SupportRelatedKind?
  relatedId       Uuid?
  resolutionNote  String?
  resolvedAt      DateTime?
  createdAt       temporal.CreatedAt
  updatedAt       temporal.UpdatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requester       User               @relation(fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  messages        SupportMessage[]

  @@unique([organizationId, reference])
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

model SupportMessage {
  id             Uuid                 @id @onCreate(uuid(7))
  organizationId Uuid
  requestId      Uuid
  authorUserId   Uuid?
  authorKind     SupportMessageAuthor
  body           String
  createdAt      temporal.CreatedAt
  updatedAt      temporal.UpdatedAt

  request        SupportRequest       @relation(fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  author         User?                @relation(fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, requestId])
  @@index([authorUserId])
}

model Feedback {
  id             Uuid               @id @onCreate(uuid(7))
  organizationId Uuid
  userId         Uuid
  type           FeedbackType
  subject        String
  message        String
  rating         Int?
  createdAt      temporal.CreatedAt
  updatedAt      temporal.UpdatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, userId, createdAt])
}

model Integration {
  id                  Uuid               @id @onCreate(uuid(7))
  organizationId      Uuid
  providerKey         String
  displayName         String
  type                IntegrationType
  status              IntegrationStatus  @default(DISCONNECTED)
  authKind            IntegrationAuthKind
  config              String?
  capabilities        String?
  webhookTokenHash    String?
  syncCursor          String?
  lastSyncAt          DateTime?
  lastSuccessfulSyncAt DateTime?
  lastSyncError       String?
  consecutiveFailures Int                @default(0)
  recordsProcessed    Int                @default(0)
  recordsFailed       Int                @default(0)
  createdByUserId     Uuid?
  createdAt           temporal.CreatedAt
  updatedAt           temporal.UpdatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  credential          IntegrationCredential?
  externalRecords     ExternalRecord[]
  syncRuns            IntegrationSyncRun[]
  webhookEvents       IntegrationWebhookEvent[]
  events              IntegrationEvent[]
  operationalSignals  OperationalSignal[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, providerKey])
}

model IntegrationCredential {
  id             Uuid               @id @onCreate(uuid(7))
  organizationId Uuid
  integrationId  Uuid
  authKind       IntegrationAuthKind
  ciphertext     String
  keyVersion     String
  hint           String?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      temporal.CreatedAt
  updatedAt      temporal.UpdatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  integration    Integration        @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, integrationId])
  @@index([organizationId])
}

model ExternalRecord {
  id             Uuid               @id @onCreate(uuid(7))
  organizationId Uuid
  integrationId  Uuid
  providerKey    String
  entityKind     ExternalEntityKind
  externalId     String
  internalKind   String?
  internalId     Uuid?
  checksum       String?
  payload        String?
  lastSyncedAt   DateTime?
  createdAt      temporal.CreatedAt
  updatedAt      temporal.UpdatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  integration    Integration        @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, providerKey, entityKind, externalId])
  @@unique([organizationId, id])
  @@index([organizationId, entityKind])
  @@index([organizationId, internalKind, internalId], name: "external_record_internal_idx")
}

model IntegrationSyncRun {
  id               Uuid                   @id @onCreate(uuid(7))
  organizationId   Uuid
  integrationId    Uuid
  trigger          IntegrationSyncTrigger
  status           IntegrationSyncStatus  @default(RUNNING)
  cursorBefore     String?
  cursorAfter      String?
  recordsSeen      Int                    @default(0)
  recordsCreated   Int                    @default(0)
  recordsUpdated   Int                    @default(0)
  recordsFailed    Int                    @default(0)
  errorCode        String?
  errorSummary     String?
  initiatedByUserId Uuid?
  startedAt        DateTime               @default(now()) @onCreate(now())
  finishedAt       DateTime?

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  integration      Integration            @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, integrationId, startedAt], name: "integration_syncrun_started_idx")
}

model IntegrationWebhookEvent {
  id             Uuid                      @id @onCreate(uuid(7))
  organizationId Uuid
  integrationId  Uuid?
  providerKey    String
  eventType      String
  externalEventId String
  payload        String?
  payloadHash    String?
  status         IntegrationWebhookStatus  @default(RECEIVED)
  attempts       Int                       @default(0)
  lastError      String?
  receivedAt     DateTime                  @default(now()) @onCreate(now())
  processedAt    DateTime?

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  integration    Integration?              @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, providerKey, externalEventId])
  @@index([organizationId, integrationId, receivedAt], name: "integration_webhook_received_idx")
}

model IntegrationEvent {
  id             Uuid                 @id @onCreate(uuid(7))
  organizationId Uuid
  integrationId  Uuid?
  actorUserId    Uuid?
  kind           IntegrationEventKind
  message        String?
  metadata       String?
  createdAt      temporal.CreatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  integration    Integration?         @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, integrationId, createdAt], name: "integration_event_created_idx")
  @@index([actorUserId])
}

model DeliveryEvent {
  id             Uuid              @id @onCreate(uuid(7))
  organizationId Uuid
  deliveryId     Uuid
  actorUserId    Uuid?
  type           DeliveryEventType
  fromStatus     DeliveryStatus?
  toStatus       DeliveryStatus?
  occurredAt     DateTime          @default(now()) @onCreate(now())
  note           String?
  location       String?

  delivery       Delivery          @relation(fields: [organizationId, deliveryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  actor          User?             @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, deliveryId, occurredAt])
  @@index([actorUserId])
}

model OperationalSignal {
  id              Uuid               @id @onCreate(uuid(7))
  organizationId  Uuid
  integrationId   Uuid?
  providerKey     String
  subjectKind     SignalSubjectKind
  subjectId       Uuid
  signalKind      String
  value           String
  provenance      String
  sourceTimestamp DateTime
  ingestedAt      DateTime           @default(now()) @onCreate(now())
  sequence        Int?
  eventId         String?
  dedupeKey       String             @default("")
  clockSkew       Boolean            @default(false)
  createdAt       temporal.CreatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  integration     Integration?       @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, providerKey, subjectKind, subjectId, signalKind, sourceTimestamp, dedupeKey])
  @@index([organizationId, subjectKind, subjectId, signalKind, sourceTimestamp], name: "opsignal_subject_idx")
  @@index([organizationId, integrationId], name: "opsignal_integration_idx")
}

model OperationalSignalLatest {
  id              Uuid               @id @onCreate(uuid(7))
  organizationId  Uuid
  providerKey     String
  subjectKind     SignalSubjectKind
  subjectId       Uuid
  signalKind      String
  signalId        Uuid
  sourceTimestamp DateTime
  value           String
  provenance      String
  conflict        Boolean            @default(false)
  createdAt       temporal.CreatedAt
  updatedAt       temporal.UpdatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, providerKey, subjectKind, subjectId, signalKind])
  @@index([organizationId, subjectKind, subjectId], name: "opsignal_latest_subject_idx")
}
