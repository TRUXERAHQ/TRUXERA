DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe billing (TEST MODE keys only — live keys are refused by the adapter)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=

# Paddle billing (SANDBOX keys only — live keys are refused by the adapter)
# Provider selection: BILLING_PROVIDER=paddle|stripe; when unset, Paddle
# Sandbox wins over Stripe test keys.
BILLING_PROVIDER=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_ANNUAL=
PADDLE_PRICE_PROFESSIONAL_MONTHLY=
PADDLE_PRICE_PROFESSIONAL_ANNUAL=
