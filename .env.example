DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe billing (TEST MODE keys only — live keys are refused by the adapter)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=

# Paddle billing (SANDBOX keys only — live keys are refused by the adapter)
# Provider selection: BILLING_PROVIDER=paddle|stripe; when unset, Paddle
# Sandbox wins over Stripe test keys.
BILLING_PROVIDER=
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_ANNUAL=
PADDLE_PRICE_PROFESSIONAL_MONTHLY=
PADDLE_PRICE_PROFESSIONAL_ANNUAL=

# Integration framework
# AES-256-GCM key (base64, 32 bytes) encrypting stored provider credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_CREDENTIALS_KEY=

# Samsara OAuth 2.0 (optional — only needed once Samsara issues developer
# credentials; the connector also works with a static API key + bearer
# token credential entered through the integration framework).
SAMSARA_OAUTH_CLIENT_ID=
SAMSARA_OAUTH_CLIENT_SECRET=
SAMSARA_OAUTH_AUTHORIZE_URL=
SAMSARA_OAUTH_TOKEN_URL=
# Optional: provider revocation endpoint, space-separated scopes, and a
# pre-registered redirect URI override (otherwise derived from the request).
SAMSARA_OAUTH_REVOKE_URL=
SAMSARA_OAUTH_SCOPES=
SAMSARA_OAUTH_REDIRECT_URI=
